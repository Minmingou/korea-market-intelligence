KIS_APP_KEY=
KIS_APP_SECRET=
# 실전투자: https://openapi.koreainvestment.com:9443 (기본값)
# 모의투자: https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

USE_MOCK_DATA=true
KIS_REFRESH_INTERVAL_SECONDS=30

DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
USE_MOCK_DART=true

# 네이버 뉴스 검색 API 발급: 2026-07-31부로 네이버클라우드플랫폼의 "NAVER API HUB"로
# 이관됨 - console.ncloud.com 가입 후 AI·Application Service > NAVER API HUB에서
# Application 등록 -> Search API 선택 (developers.naver.com에는 더 이상 없음)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEWS_API_KEY=
USE_MOCK_NEWS=true

LLM_API_KEY=
USE_MOCK_LLM=true

DATABASE_URL=sqlite:///../data/korea_market.db
